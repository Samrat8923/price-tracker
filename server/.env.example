# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Secret for external cron job trigger (POST /api/cron/scrape)
CRON_SECRET=your_secure_cron_secret_here

# Supabase Configuration
# When set, production uses Supabase PostgreSQL.
# If left empty, server runs with local fallback for testing.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=35000
SCRAPER_MAX_RETRIES=3
STOREFRONT_BASE_URL=https://demo.inelabteamdev.com
